# Caddy on the VM (/etc/caddy/Caddyfile). Copy, then: caddy validate && systemctl reload caddy
# Cloudflare proxies slff.eu, www and api (Full strict, Cloudflare Origin cert, key generated on the VM).

(origin_tls) {
	tls /etc/caddy/certs/slff-origin.pem /etc/caddy/certs/slff-origin.key
}

# Auth email templates for GoTrue only (reachable from containers, not the internet).
# GoTrue asks for host.docker.internal:8089 (docker-compose.slff.yml); a site block
# that matched only 172.17.0.1 answered that Host with an EMPTY 200, so from
# 2026-10-07 every confirmation and password email went out blank (0 of 44
# sign-ups confirmed). Both names, and `bind` keeps it off the internet.
http://172.17.0.1:8089, http://host.docker.internal:8089 {
	bind 172.17.0.1
	root * /opt/supabase/volumes/templates
	file_server
}

# API: self-hosted Supabase on this VM (since the P4 cutover, 2026-10-06 20:33 UTC).
# This file is the source of truth for /etc/caddy/Caddyfile: never point it back at Cloud.
api.slff.eu {
	import origin_tls
	reverse_proxy localhost:8000 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}

# Umami dashboard. Proxied A record `stats` in Cloudflare; the origin cert must cover it
# (it is *.slff.eu if `openssl x509 -in /etc/caddy/certs/slff-origin.pem -noout -ext subjectAltName` says so).
stats.slff.eu {
	import origin_tls
	reverse_proxy localhost:3100
}

# www is the same site twice for search engines: one address, a permanent redirect.
www.slff.eu {
	import origin_tls
	header Strict-Transport-Security "max-age=31536000"
	redir https://slff.eu{uri} 301
}

# Website: a 1:1 port of vercel.json. CI rsyncs dist/ to /srv/slff/releases/<sha> and moves `current`.
slff.eu {
	import origin_tls
	root * /srv/slff/current
	encode zstd gzip

	# HTTPS only, for a year. Without includeSubDomains: mail.slff.eu (Mailcow) and the
	# rest are not ours to promise for here; no preload either (hard to undo).
	header Strict-Transport-Security "max-age=31536000"

	# Old Slovenian paths (STARE_POTI in src/App.tsx) as real 301s, query kept; the SPA
	# redirect stays for the app and for # fragments (never sent to the server).
	# NOT /novo-geslo: Supabase sends password resets there with the token in #.
	@stara_pot path /moja-ekipa /glasovanje /pozicije /odsotnosti /igralci /lestvica /slovenija /mini-lige /rezultati /prijava /pravno /opomniki /igralec/* /ekipa/* /klub/* /tekma/*
	# `handle`, not a bare `route`: handles run before routes, so the SPA catch-all
	# below would win. Caddy 2.6 has no {?query}: rename the path in place (`route`
	# keeps this order), then {uri} carries the query.
	handle @stara_pot {
		route {
			uri path_regexp ^/moja-ekipa$ /my-team
			uri path_regexp ^/glasovanje$ /assists
			uri path_regexp ^/pozicije$ /positions
			uri path_regexp ^/odsotnosti$ /absences
			uri path_regexp ^/igralci$ /players
			uri path_regexp ^/lestvica$ /standings
			uri path_regexp ^/slovenija$ /national
			uri path_regexp ^/mini-lige$ /mini-leagues
			uri path_regexp ^/rezultati$ /results
			uri path_regexp ^/prijava$ /login
			uri path_regexp ^/pravno$ /legal
			uri path_regexp ^/opomniki$ /reminders
			uri path_regexp ^/igralec/ /player/
			uri path_regexp ^/ekipa/ /team/
			uri path_regexp ^/klub/ /club/
			uri path_regexp ^/tekma/ /match/
			redir * https://slff.eu{uri} 301
		}
	}

	# The same page with a trailing slash (/players/): one address for search engines,
	# 301 to the canonical one without it, query kept (same trick as @stara_pot).
	@posevnica path_regexp ^/(my-team|assists|positions|absences|players|standings|national|mini-leagues|results|table|login|legal|reminders|account|admin|si|sk|hr|cz|hu|at|rs|ro)/$
	handle @posevnica {
		route {
			uri path_regexp ^(/[a-z-]+)/$ $1
			redir * https://slff.eu{uri} 301
		}
	}

	# Vercel's defaults: every response may be read cross-origin and is revalidated.
	# `?` = only if a more specific rule below didn't set it. No `-Server` here: a delete
	# defers the whole block to the end, and it would overwrite the specific rules.
	header {
		Access-Control-Allow-Origin *
		?Cache-Control "public, max-age=0, must-revalidate"
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	header -Server
	# Private or per-user pages stay out of search results (they are not in the sitemap
	# either). Keep in sync with the routes in src/App.tsx.
	@zasebne path /my-team /mini-leagues /login /account /reminders /new-password /novo-geslo /admin /auth/* /team/* /l/*
	header @zasebne X-Robots-Tag "noindex"
	# Hashed by Vite; a new build means new names.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /app/latest.json Cache-Control no-store

	# Static images (crests, photos, logos, sponsors, share cards) are not hashed, but
	# rarely change: a week in the browser and on Cloudflare, then revalidated in the
	# background. A replaced crest shows up within a week at the latest.
	@staticne_slike path /grbi/* /foto/* /logo/* /sponzorji/* /og/*
	header @staticne_slike Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	header /.well-known/apple-app-site-association Content-Type application/json

	# Support link (components/Pivo.tsx) to Buy Me a Coffee: /pivo?src=<where> ->
	# utm_medium=<where>, so the BMC dashboard shows where clicks come from. Only a short
	# lowercase name is passed through (anything else would land unescaped in the URL).
	# 302: the target may change.
	@pivo_vir {
		path /pivo
		expression `{query.src}.matches("^[a-z0-9-]{1,30}$")`
	}
	redir @pivo_vir https://buymeacoffee.com/slff?utm_source=slff&utm_medium={query.src} 302
	redir /pivo https://buymeacoffee.com/slff?utm_source=slff 302

	# Umami (statistika obiska) first-party: only the script and the collect endpoint,
	# never the dashboard (that is stats.slff.eu). src/lib/analitika.ts loads /u/s.js.
	@umami path /u/s.js /u/api/send
	handle @umami {
		uri strip_prefix /u
		# The site block already sends Access-Control-Allow-Origin *; a second copy from
		# Umami would make two values and the app (capacitor://localhost) would fail CORS.
		reverse_proxy localhost:3100 {
			header_down -Access-Control-Allow-Origin
		}
	}

	# Supabase API on the site's own origin (src/lib/supabase.ts, VITE_API_ISTI_IZVOR=1): the
	# browser then skips the CORS preflight (OPTIONS) it sends before calls to api.slff.eu.
	# The same Kong as api.slff.eu, which stays exactly as it is (mobile app, old builds,
	# scripts, edge functions, OAuth callbacks registered at Google/Apple).
	@supabase_api path /rest/v1/* /auth/v1/* /storage/v1/* /functions/v1/* /realtime/v1/*
	handle @supabase_api {
		# Answers are per user: never the site default "public" from the header block above.
		header Cache-Control "private, no-store"
		reverse_proxy localhost:8000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			# Kong echoes the origin; the site block already sends Access-Control-Allow-Origin *,
			# and two values would fail CORS for anyone still calling cross-origin.
			header_down -Access-Control-Allow-Origin
		}
	}

	# Was api/drzava.ts on Vercel Edge: the visitor's country, from Cloudflare.
	handle /api/drzava {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "private, no-store"
		@znana header_regexp drzava Cf-Ipcountry ^[A-Z]{2}$
		respond @znana `{"drzava":"{re.drzava.0}"}` 200
		respond `{"drzava":null}` 200
	}
	handle /api/* {
		respond "Not Found" 404
	}

	# Sitemaps per league: written nightly by .github/workflows/sitemap.yml
	# (scripts/sitemap.mjs) into /srv/slff/sitemap/, outside the release dir, which every
	# deploy replaces. The static /sitemap.xml stays in dist/ (public/sitemap.xml).
	@sitemap path /sitemap-index.xml /sitemap-*.xml
	handle @sitemap {
		root * /srv/slff/sitemap
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Strani igralca, kluba, tekme, lig in vstopne strani držav (/si, /at …): strežnik HTML (scripts/hetzner/html/, kontejner
	# slff-html) vpiše naslov, opis, kanonični naslov, JSON-LD in povzetek v predlogo.
	# Ob napaki sam vrne nespremenjeno predlogo. Če ne teče (dial) ali v 1,5 s ne
	# odgovori, gre zahtevek na 127.0.0.1:3201 spodaj — isto statično predlogo kot
	# pred njim — in strežnik je 30 s izločen. Caddy 2.6 ponovi po napaki odgovora
	# le zahtevke iz lb_retry_match (privzeto samo GET), zato še HEAD.
	@html_strani {
		method GET HEAD
		path / /table /results /standings /players /player/* /club/* /match/* /si /sk /hr /cz /hu /at /rs /ro
	}
	handle @html_strani {
		reverse_proxy 127.0.0.1:3200 127.0.0.1:3201 {
			lb_policy first
			lb_try_duration 2s
			lb_retry_match {
				method GET HEAD
			}
			fail_duration 30s
			transport http {
				dial_timeout 300ms
				response_header_timeout 1500ms
			}
		}
	}

	handle {
		# Static files win; only paths without a dot fall through to the SPA (vercel.json `(?!.*\.)`).
		@datoteka file
		@sk_vstop path /sk /sk/
		@hr_vstop path /hr /hr/
		@cz_vstop path /cz /cz/
		@hu_vstop path /hu /hu/
		@at_vstop path /at /at/
		@rs_vstop path /rs /rs/
		@ro_vstop path /ro /ro/
		@sk_liga {
			not path *.*
			expression `{query.t}.startsWith("sk-")`
		}
		@hr_liga {
			not path *.*
			expression `{query.t}.startsWith("hr-")`
		}
		@cz_liga {
			not path *.*
			expression `{query.t}.startsWith("cz-")`
		}
		@hu_liga {
			not path *.*
			expression `{query.t}.startsWith("hu-")`
		}
		@at_liga {
			not path *.*
			expression `{query.t}.startsWith("at-")`
		}
		@rs_liga {
			not path *.*
			expression `{query.t}.startsWith("rs-")`
		}
		@ro_liga {
			not path *.*
			expression `{query.t}.startsWith("ro-")`
		}
		@spa not path *.*
		# Real 404s: a path that is no route of src/App.tsx gets the SPA (NiStrani) with
		# status 404 (handle_errors below). Keep this list in sync with <Routes>.
		# Missing ids (/player/999999999) stay 200; the page sets noindex itself.
		@ni_strani {
			not path *.*
			not path / /sk /hr /cz /hu /at /rs /ro /si
			not path /my-team /assists /positions /absences /players /standings /national /mini-leagues /results /table
			not path /player/* /team/* /club/* /match/* /l/*
			not path /login /new-password /novo-geslo /legal /reminders /account /auth/confirm /admin
		}
		route {
			file_server @datoteka
			error @ni_strani 404
			rewrite @sk_vstop /sk.html
			rewrite @hr_vstop /hr.html
			rewrite @cz_vstop /cz.html
			rewrite @hu_vstop /hu.html
			rewrite @at_vstop /at.html
			rewrite @rs_vstop /rs.html
			rewrite @ro_vstop /ro.html
			rewrite @sk_liga /sk.html
			rewrite @hr_liga /hr.html
			rewrite @cz_liga /cz.html
			rewrite @hu_liga /hu.html
			rewrite @at_liga /at.html
			rewrite @rs_liga /rs.html
			rewrite @ro_liga /ro.html
			rewrite @spa /index.html
			file_server
		}
	}

	# Caddy 2.6 (apt) has no `handle_errors 404`; Vercel answers missing files with plain text.
	# A missing page (no dot, @ni_strani above) gets the SPA instead: file_server in an
	# error route keeps the error's status, so it is index.html with 404.
	handle_errors {
		@spa_404 {
			not path *.*
			expression `{err.status_code} == 404`
		}
		handle @spa_404 {
			header Strict-Transport-Security "max-age=31536000"
			rewrite * /index.html
			file_server
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}

# Rezerva strežnika HTML (@html_strani zgoraj): predloga kot v slff.eu — kartica države
# za vstop (/sk) ali po predponi `?t=sk-…`, sicer index.html. Le na 127.0.0.1, glave doda slff.eu.
# Naslov brez imena (`:3201`): reverse_proxy pošlje Host slff.eu, blok samo za
# 127.0.0.1 bi ga ujel le prazen 200 (kot predloge pošte 7. 10. zgoraj).
http://:3201 {
	bind 127.0.0.1
	root * /srv/slff/current
	map {query.t} {html_predloga} {
		~^(sk|hr|cz|hu|at|rs|ro)- /${1}.html
		default /index.html
	}
	@vstop path_regexp vstop ^/(sk|hr|cz|hu|at|rs|ro)$
	handle @vstop {
		rewrite * /{re.vstop.1}.html
		file_server
	}
	handle {
		rewrite * {html_predloga}
		file_server
	}
}
